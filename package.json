{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go --lan --clear",
    "start:go:tunnel": "expo start --go --tunnel --clear",
    "start:all": "node scripts/start-all.mjs",
    "start:all:tunnel": "node scripts/start-all.mjs --tunnel",
    "supabase:setup": "node scripts/run-supabase-setup.mjs",
    "verify:rls": "node scripts/verify-rls.mjs",
    "supabase:types": "supabase gen types typescript --linked > src/lib/database.types.ts",
    "ai:install": "pip install -r server/requirements.txt",
    "ai:install:dev": "pip install -r server/requirements-dev.txt",
    "ai:test": "cd server && pytest tests/",
    "ai:train:taco": "python server/train_taco_classifier.py --dataset-root ./server/taco-dataset",
    "ai:start": "python server/classifier_api.py",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.100.1",
    "expo": "^57.0.20",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.16",
    "expo-router": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "^1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "^0.21.2",
    "react-native-webview": "^13.16.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "~19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.3",
    "vitest": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
